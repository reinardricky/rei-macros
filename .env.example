# Copy this file to `.env` and fill in your key. `.env` is git-ignored.
#
# Note: EXPO_PUBLIC_ variables are bundled into the app, so anyone with the APK
# can read these keys. That's fine for a personal app that never leaves your phone.

# Gemini (default). Free key: https://aistudio.google.com/apikey
EXPO_PUBLIC_GEMINI_API_KEY=

# Optional: switch to Claude by uncommenting both lines below.
# Key from https://console.anthropic.com/settings/keys (billed pay-as-you-go).
# EXPO_PUBLIC_AI_PROVIDER=claude
# EXPO_PUBLIC_ANTHROPIC_API_KEY=
