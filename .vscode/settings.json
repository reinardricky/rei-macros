{
  // android/ is generated by `expo prebuild` and built from the terminal.
  // Letting the Java/Gradle extensions import it starts a second Gradle run
  // that fights `npm run android` over the native (CMake) build folders.
  "java.import.gradle.enabled": false,
  "java.configuration.updateBuildConfiguration": "disabled",
  "gradle.autoDetect": "off"
}
